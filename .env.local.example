# Скопируй этот файл в .env.local и заполни значениями из LiveKit Cloud.
# .env.local в git НЕ попадает (см. .gitignore). Эти же переменные нужно
# задать в настройках проекта на Vercel (Settings → Environment Variables).

# --- LiveKit (берётся в дашборде проекта на livekit.io) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WebSocket-адрес проекта. Нужен и серверу, и клиенту.
# NEXT_PUBLIC_ — версия, доступная в браузере (это не секрет).
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Привязка устройств без логина ---
# Любой длинный случайный секрет. Кладётся на устройство один раз через /setup,
# дальше отправляется автоматически. Без него токен на звонок не выдаётся.
FAMILY_CODE=change-me-to-a-long-random-secret
